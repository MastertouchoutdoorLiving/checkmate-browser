{
  "name": "multispace-browser",
  "productName": "MultiSpace Browser",
  "version": "1.6.0",
  "description": "CheckMate Browser: spaces, apps, iMessage and WhatsApp in one window",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "install-mac": "bash scripts/install-mac.sh",
    "share-mac": "bash scripts/share-mac.sh"
  },
  "license": "MIT",
  "dependencies": {
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.multispace.browser",
    "productName": "MultiSpace Browser",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "artifactName": "CheckMate-Browser-${version}.${ext}",
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDisplayName": "CheckMate Browser"
      }
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "dmg": {
      "title": "CheckMate Browser",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MastertouchoutdoorLiving/checkmate-browser.git"
  }
}
